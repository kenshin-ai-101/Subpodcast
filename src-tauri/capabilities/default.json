{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities for Subpodcast MVP",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-add-subscription",
    "allow-refresh-show",
    "allow-refresh-all",
    "allow-list-shows",
    "allow-list-episodes",
    "allow-get-episode",
    "allow-remove-show",
    "allow-set-progress",
    "allow-search-podcasts",
    "allow-youtube-subscriptions",
    "allow-open-privacy-settings",
    "allow-load-transcript",
    "allow-fetch-official-transcript",
    "allow-get-blob",
    "allow-set-blob",
    "allow-get-settings",
    "allow-set-settings",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-llm-chat",
    "allow-translate-batch",
    "allow-cloud-transcribe",
    "allow-list-models",
    "allow-export-opml",
    "allow-storage-info",
    "allow-open-data-folder",
    "allow-clear-temp"
  ]
