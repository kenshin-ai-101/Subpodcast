{
  "name": "subpodcast",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check src",
    "format:check": "biome format src",
    "i18n": "node scripts/check-i18n.mjs",
